rules_version = '2';

/**
 * Regras de segurança do Firestore para o projeto Senac CyberAprendiz.
 *
 * Coleção: cyberAprendiz_newsletterSubscribers (nome configurável via
 * variável de ambiente VITE_FIREBASE_NEWSLETTER_COLLECTION — mantenha este
 * arquivo em sincronia caso o nome seja alterado).
 *
 * Estratégia:
 * - O ID do documento é o e-mail normalizado. Isso permite que a regra de
 *   "create" verifique se o documento já existe (impede duplicidade).
 * - Leitura pública é NEGADA: o frontend nunca lista nem lê e-mails de
 *   outros participantes. A aplicação só faz "get" de um documento
 *   específico (o do próprio e-mail que o usuário está tentando cadastrar)
 *   para checar duplicidade — mesmo assim, o conteúdo do documento não é
 *   exibido ao usuário.
 * - "update"/"delete" são negados ao cliente: qualquer correção ou exclusão
 *   solicitada por um participante deve ser tratada manualmente ou por uma
 *   função de backend com privilégios de administrador (Admin SDK), nunca
 *   diretamente pelo frontend.
 * - Validação de formato e tamanho é feita nas regras como uma segunda
 *   camada de defesa (a primeira é o Zod no frontend). Isso NÃO substitui
 *   uma função de backend com rate limiting; veja o README para o plano de
 *   evolução com Cloud Functions.
 *
 * Área administrativa (cyberAprendiz_admins):
 * - Um usuário é considerado administrador se existir um documento com seu
 *   UID (obtido via Firebase Authentication) na coleção
 *   `cyberAprendiz_admins`. Essa coleção não é gerenciada pelo frontend —
 *   os documentos devem ser criados manualmente pelo Console do Firebase
 *   (ou por uma Cloud Function com Admin SDK), nunca pelo cliente.
 * - A função `isAdmin()` abaixo é usada para liberar a LEITURA da coleção
 *   de inscritos (nome/e-mail) somente para administradores autenticados.
 *   O público em geral continua sem qualquer acesso de leitura.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/cyberAprendiz_admins/$(request.auth.uid));
    }

    match /cyberAprendiz_admins/{adminUid} {
      // Um usuário autenticado pode ler APENAS o próprio documento (para o
      // frontend confirmar se ele é administrador). Ninguém pode ler o
      // documento de outro UID, e ninguém pode escrever por aqui — a
      // concessão de acesso administrativo é feita manualmente pelo
      // Console do Firebase.
      allow read: if request.auth != null && request.auth.uid == adminUid;
      allow write: if false;
    }

    match /cyberAprendiz_newsletterSubscribers/{emailId} {
      allow read: if isAdmin();

      allow create: if
        // Garante que o ID do documento é o próprio e-mail normalizado
        // enviado no corpo, prevenindo inconsistência e facilitando a
        // checagem de duplicidade.
        request.resource.data.emailNormalized == emailId &&
        request.resource.data.emailNormalized is string &&
        request.resource.data.emailNormalized.size() > 3 &&
        request.resource.data.emailNormalized.size() < 255 &&
        request.resource.data.emailNormalized.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.consentStatus == 'granted' &&
        request.resource.data.consentPolicyVersion is string &&
        request.resource.data.source is string &&
        // Opcional: nome, se presente, deve ser uma string curta.
        (!('name' in request.resource.data) ||
          (request.resource.data.name is string &&
           request.resource.data.name.size() <= 120)) &&
        // Impede sobrescrever um cadastro existente.
        !exists(/databases/$(database)/documents/cyberAprendiz_newsletterSubscribers/$(emailId));

      allow update: if false;
      allow delete: if false;
    }

    // Marcador de "e-mail já participou do quiz". Contém apenas a data, sem
    // nome/pontuação, então pode ter leitura pública de um documento por vez
    // (get). Listagem é negada. Só pode ser criado junto com a participação
    // correspondente (mesmo batch).
    match /cyberAprendiz_quizParticipants/{emailId} {
      allow get: if true;
      allow list: if false;
      allow create: if
        existsAfter(/databases/$(database)/documents/cyberAprendiz_quizEntries/$(emailId)) &&
        !exists(/databases/$(database)/documents/cyberAprendiz_quizParticipants/$(emailId));
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /cyberAprendiz_quizEntries/{emailId} {
      allow read: if isAdmin();

      allow create: if
        request.resource.data.emailNormalized == emailId &&
        request.resource.data.emailNormalized is string &&
        request.resource.data.emailNormalized.size() > 3 &&
        request.resource.data.emailNormalized.size() < 255 &&
        request.resource.data.emailNormalized.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.score is int &&
        request.resource.data.totalQuestions is int &&
        request.resource.data.durationMs is int &&
        request.resource.data.durationMs >= 0 &&
        request.resource.data.consentPolicyVersion is string &&
        request.resource.data.source is string &&
        // Impede sobrescrever uma participação existente.
        !exists(/databases/$(database)/documents/cyberAprendiz_quizEntries/$(emailId));

      allow update: if false;
      // Apenas administradores autenticados podem remover participações
      // (ex.: após o sorteio/premiação, para limpar a lista).
      allow delete: if isAdmin();
    }
  }
}
