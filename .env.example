# Copie este arquivo para ".env" e preencha com os valores do seu projeto Firebase.
# Nunca commite o arquivo ".env" real (ele já está no .gitignore).
#
# Como obter esses valores:
# 1. Acesse https://console.firebase.google.com/
# 2. Crie (ou abra) um projeto Firebase.
# 3. Em "Configurações do projeto" > "Geral", adicione um app Web.
# 4. Copie o objeto de configuração exibido e preencha as variáveis abaixo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Nome da coleção do Firestore dedicada aos interessados do CyberAprendiz.
# Use um nome exclusivo para não colidir com outros projetos que usem o mesmo
# projeto Firebase (ex.: se o Firebase for compartilhado com outra aplicação).
VITE_FIREBASE_NEWSLETTER_COLLECTION=cyberAprendiz_newsletterSubscribers
